# Копируйте в .env для `docker compose up -d --build`.
#
# ВАЖНО: Docker Compose читает .env построчно. Допускаются только VAR=значение и комментарии,
# где первый символ строки — # . Любая строка без = и без # (например заголовок) даст ошибку
# вида «unexpected character in variable name».
#
# Обычный запуск поднимает только backend/frontend; PostgreSQL задаётся здесь. Файлы счетов
# хранятся в той же рабочей базе (таблицы files / file_contents).

# Публичный URL frontend без слэша в конце.
PUBLIC_ORIGIN=http://localhost

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/mrp_bom_orders
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true

SEED_ON_STARTUP=true
FORCE_RESEED=true
