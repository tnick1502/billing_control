# Копируйте в .env для `docker compose up -d --build`.
#
# ВАЖНО: Docker Compose читает .env построчно. Допускаются только VAR=значение и комментарии,
# где первый символ строки — # . Любая строка без = и без # (например заголовок) даст ошибку
# вида «unexpected character in variable name».
#
# Обычный запуск поднимает только backend/frontend; PostgreSQL задаётся здесь. Файлы счетов
# хранятся в той же рабочей базе (таблицы files / file_contents).

# Публичный URL frontend без слэша в конце.
PUBLIC_ORIGIN=http://localhost

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
FRONTEND_ORIGIN=http://localhost
FRONTEND_BACKEND_ORIGIN=http://backend:8000
FRONTEND_PROTOCOL_HEADER=x-forwarded-proto
FRONTEND_HOST_HEADER=x-forwarded-host
FRONTEND_BODY_SIZE_LIMIT=104857600

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/mrp_bom_orders
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true

# Необязательная совместимая S3-конфигурация. Текущий backend хранит вложения
# в PostgreSQL и пока не читает эти переменные.
S3_ENDPOINT_URL=https://s3.example.invalid
S3_PUBLIC_ENDPOINT_URL=https://s3.example.invalid
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=replace-me
S3_REGION=replace-me

# Пул подключений backend к PostgreSQL. Для managed-БД с небольшим лимитом держим пул маленьким:
# конкурентные запросы немного подождут свободное соединение вместо исчерпания лимита БД.
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
# Backend не запустится, если pool size + overflow превысят этот безопасный бюджет.
DB_CONNECTION_BUDGET=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# INFO + одна итоговая строка на запрос с request_id, временем и состоянием пула.
LOG_LEVEL=INFO
LOG_REQUESTS=true

# Авторизационная сессия: 720 часов = 30 дней.
SESSION_TTL_HOURS=720
SESSION_IDLE_RENEW_MINUTES=30

# В production не запускаем тестовый seed. FORCE_RESEED=true очищает рабочие таблицы
# перед заполнением демо-данными и поэтому в production запрещён.
SEED_ON_STARTUP=false
FORCE_RESEED=false
WIPE_DB=false

# --- docker-compose.dev.yml ---
# Отдельные DEV_* исключают случайное подключение dev-compose к production.
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_DB=mrp_bom_orders
DEV_POSTGRES_PORT=5432
DEV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/mrp_bom_orders
DEV_DATABASE_SSL=false
DEV_DATABASE_SSL_VERIFY=true
DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
DEV_PUBLIC_ORIGIN=http://localhost
DEV_FRONTEND_ORIGIN=http://localhost:3000
DEV_BACKEND_PORT=8000
DEV_FRONTEND_PORT=3000
DEV_SEED_ON_STARTUP=true
DEV_FORCE_RESEED=false
DEV_WIPE_DB=false
