# Копируйте в .env для `docker compose up -d --build`.
#
# ВАЖНО: Docker Compose читает .env построчно. Допускаются только VAR=значение и комментарии,
# где первый символ строки — # . Любая строка без = и без # (например заголовок) даст ошибку
# вида «unexpected character in variable name».
#
# Обычный запуск поднимает только backend/frontend; PostgreSQL и S3 задаются здесь.

# Публичный URL frontend без слэша в конце.
# Локально: http://localhost
# Сервер:   http://203.0.113.10
PUBLIC_ORIGIN=http://localhost

# CORS для API (добавьте свой домен/IP)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/mrp_bom_orders
# Для облачной БД с обязательным TLS: DATABASE_SSL=true
DATABASE_SSL=false
# При SSLCertVerificationError / self-signed: DATABASE_SSL_VERIFY=false (шифрование есть, без проверки цепочки)
DATABASE_SSL_VERIFY=true

# --- S3 / MinIO ---
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=invoices
S3_REGION=us-east-1

SEED_ON_STARTUP=true
FORCE_RESEED=false
